+FWorldScapePreparedReservation::~FWorldScapePreparedReservation()
+{
+    const int64 Before = LiveBytes.fetch_sub(Bytes);
+    check(Before >= Bytes);
+}
+
+bool FWorldScapePreparedLod::Build(const UWorldScapeLod& Lod)
+{
+    TRACE_CPUPROFILER_EVENT_SCOPE(WS_PreparePublicationPayload);
+    bReady = false;
+    if (!Reservation || !BuildSection(Sections[0], bPrepareRender, Lod.Vertices, Lod.Normals, Lod.UV, Lod.UV1, Lod.VertexColors, Lod.Tangents)
+        || !BuildSection(Sections[1], bPrepareRender, Lod.VerticesPA, Lod.VerticesNormalPA, Lod.UVPA, Lod.UV1PA, Lod.VerticesColorPA, Lod.TangentsPA)
+        || !BuildSection(Sections[2], bPrepareRender, Lod.VerticesPB, Lod.VerticesNormalPB, Lod.UVPB, Lod.UV1PB, Lod.VerticesColorPB, Lod.TangentsPB)) return false;
+    int64 Actual = 0;
+    for (const auto& Section : Sections)
+    {
+        Actual += Section.CpuVertices.GetAllocatedSize() + Section.RenderVertices.GetAllocatedSize();
+        if (Section.PackedBuffers)
+        {
+            const auto& B = *Section.PackedBuffers;
+            Actual += B.PositionVertexBuffer.GetAllocatedSize() + B.ColorVertexBuffer.GetAllocatedSize()
+                + B.StaticMeshVertexBuffer.GetTangentSize() + B.StaticMeshVertexBuffer.GetTexCoordSize();
+        }
+    }
+    if (Actual > Reservation->Bytes) return false;
+    bReady = true;
+    ++Built;
+    return true;
+}
+
+TUniquePtr<FWorldScapePreparedLod> WorldScapePreparedMesh::Capture(UWorldScapeLod& Lod)
+{
+    check(IsInGameThread());
+    const int32 Mode = CVarPrepared.GetValueOnGameThread();
+    if (Mode == 0 || !IsValid(Lod.GetOwner())
+        || (Mode < 0 && !Lod.GetOwner()->ActorHasTag(TEXT("APS.Mesh.PreparedPublication")))
+        || !Lod.GetOwner()->ActorHasTag(TEXT("APS.Collision.ParallelSamples"))
+        || !IsValid(Lod.Mesh) || Lod.Mesh->GetCollisionEnabled() != ECollisionEnabled::NoCollision
+        || Lod.Mesh->GetNumSections() != 3) return {};
+    int64 Bytes = 0;
+    const bool bPack = CVarPrepareRender.GetValueOnGameThread() != 0;
+    for (int32 I = 0; I < 3; ++I)
+    {
+        const auto* Section = Lod.Mesh->GetProcMeshSection(I);
+        if (!Section || Section->bEnableCollision) return {};
+        // Reserve() quantization/allocator overhead is bounded conservatively;
+        // actual TArray allocations are checked again after preparation.
+        Bytes += int64(Section->PlanetVertexBuffer.Num()) * (sizeof(FWorldScapeMeshVertex) * 2 + (bPack ? 64 : 0)) + 65536;
+    }
+    const int64 Limit = int64(FMath::Clamp(CVarBudget.GetValueOnGameThread(), 0, 4096)) * 1024 * 1024;
+    if (!Reserve(Bytes, Limit)) return {};
+    auto Result = MakeUnique<FWorldScapePreparedLod>();
+    Result->bPrepareRender = bPack;
+    Result->Reservation = MakeShared<FWorldScapePreparedReservation, ESPMode::ThreadSafe>(Bytes);
+    for (int32 I = 0; I < 3; ++I)
+        Result->Sections[I].Previous = MakeArrayView(Lod.Mesh->GetProcMeshSection(I)->PlanetVertexBuffer);
+    return Result;
+}
+
+int64 WorldScapePreparedMesh::CurrentBytes() { return LiveBytes.load(); }
+bool WorldScapePreparedMesh::CopyPreparedRenderBuffers(FStaticMeshVertexBuffers& D, const FStaticMeshVertexBuffers& S)
+{
+    // Validate every format/size before any memcpy. Unknown layouts fall back to
+    // the original conversion loop, preserving future platform/plugin changes.
+    if (!PreparedLayoutMatches(D, S)) return false;
+    FMemory::Memcpy(D.PositionVertexBuffer.GetVertexData(), S.PositionVertexBuffer.GetVertexData(), S.PositionVertexBuffer.GetAllocatedSize());
+    FMemory::Memcpy(D.ColorVertexBuffer.GetVertexData(), S.ColorVertexBuffer.GetVertexData(), S.ColorVertexBuffer.GetAllocatedSize());
+    FMemory::Memcpy(D.StaticMeshVertexBuffer.GetTangentData(), S.StaticMeshVertexBuffer.GetTangentData(), S.StaticMeshVertexBuffer.GetTangentSize());
+    FMemory::Memcpy(D.StaticMeshVertexBuffer.GetTexCoordData(), S.StaticMeshVertexBuffer.GetTexCoordData(), S.StaticMeshVertexBuffer.GetTexCoordSize());
+    return true;
+}
+bool WorldScapePreparedMesh::PreparedLayoutMatches(const FStaticMeshVertexBuffers& D, const FStaticMeshVertexBuffers& S)
+{
+    return !(D.PositionVertexBuffer.GetNumVertices() != S.PositionVertexBuffer.GetNumVertices()
+        || D.PositionVertexBuffer.GetStride() != S.PositionVertexBuffer.GetStride()
+        || D.ColorVertexBuffer.GetAllocatedSize() != S.ColorVertexBuffer.GetAllocatedSize()
+        || D.StaticMeshVertexBuffer.GetNumVertices() != S.StaticMeshVertexBuffer.GetNumVertices()
+        || D.StaticMeshVertexBuffer.GetNumTexCoords() != S.StaticMeshVertexBuffer.GetNumTexCoords()
+        || D.StaticMeshVertexBuffer.GetUseFullPrecisionUVs() != S.StaticMeshVertexBuffer.GetUseFullPrecisionUVs()
+        || D.StaticMeshVertexBuffer.GetUseHighPrecisionTangentBasis() != S.StaticMeshVertexBuffer.GetUseHighPrecisionTangentBasis()
+        || D.StaticMeshVertexBuffer.GetTangentSize() != S.StaticMeshVertexBuffer.GetTangentSize()
+        || D.StaticMeshVertexBuffer.GetTexCoordSize() != S.StaticMeshVertexBuffer.GetTexCoordSize()
+        || D.PositionVertexBuffer.GetAllocatedSize() != S.PositionVertexBuffer.GetAllocatedSize());
+}
