+#pragma once
+
+#include "WorldScapeMeshComponent.h"
+
+class UWorldScapeLod;
+struct FStaticMeshVertexBuffers;
+
+// The reservation follows the task and its render commands. It is released
+// only after all transient arrays have died, including on the render thread.
+struct WORLDSCAPECORE_API FWorldScapePreparedReservation
+{
+    explicit FWorldScapePreparedReservation(int64 InBytes) : Bytes(InBytes) {}
+    ~FWorldScapePreparedReservation();
+    const int64 Bytes;
+};
+
+struct FWorldScapePreparedMeshSection
+{
+    // Borrowed under the existing root task fence, not an unbounded cache.
+    // GT never replaces these sections until all LOD tasks have completed;
+    // root reset/destruction must drain the same tasks before destroying meshes.
+    TConstArrayView<FWorldScapeMeshVertex> Previous;
+    TArray<FWorldScapeMeshVertex> CpuVertices;
+    TArray<FWorldScapeMeshVertex> RenderVertices;
+    // CPU storage only: never InitResource or enqueue RHI work on the worker.
+    TSharedPtr<FStaticMeshVertexBuffers, ESPMode::ThreadSafe> PackedBuffers;
+    FBox Bounds = FBox(ForceInit);
+};
+
+struct WORLDSCAPECORE_API FWorldScapePreparedLod
+{
+    // Declare before arrays: reverse destruction order releases memory first.
+    TSharedPtr<FWorldScapePreparedReservation, ESPMode::ThreadSafe> Reservation;
+    FWorldScapePreparedMeshSection Sections[3];
+    bool bReady = false;
+    bool bPrepareRender = false;
+    bool Build(const UWorldScapeLod& Lod);
+};
+
+namespace WorldScapePreparedMesh
+{
+    // Capture on GT before dispatch; only the worker touches the new buffers.
+    WORLDSCAPECORE_API TUniquePtr<FWorldScapePreparedLod> Capture(UWorldScapeLod& Lod);
+    WORLDSCAPECORE_API int64 CurrentBytes();
+    WORLDSCAPECORE_API int64 PeakBytes();
+    WORLDSCAPECORE_API void Published();
+    WORLDSCAPECORE_API void LogStats();
+    WORLDSCAPECORE_API bool CopyPreparedRenderBuffers(FStaticMeshVertexBuffers& Destination,
+        const FStaticMeshVertexBuffers& Source);
+    // APS 09.10 night: the same format/size validation without the CPU copy, so the render thread can upload
+    // straight from the worker-packed buffers (one copy instead of two).
+    WORLDSCAPECORE_API bool PreparedLayoutMatches(const FStaticMeshVertexBuffers& Destination,
+        const FStaticMeshVertexBuffers& Source);
+}
