+#include "WorldScapePreparedMesh.h"
+#include "WorldScapeLod.h"
+#include "HAL/IConsoleManager.h"
+#include "StaticMeshResources.h"
+#include "DynamicMeshBuilder.h"
+#include "ProfilingDebugging/CpuProfilerTrace.h"
+#include <atomic>
+
+namespace
+{
+    TAutoConsoleVariable<int32> CVarPrepared(TEXT("worldscape.PreparedMesh"), -1,
+        TEXT("Worker publication: -1 approved APS roots only (default), 0 off, 1 all APS tagged visual roots."));
+    // APS 09.10 night: 384 MiB held ~10 rings of 256; a fast pass near the home planet (terrain + ocean on one lattice)
+    // needs ~14 rings per batch, so the rest fell back to the legacy path (GT UpdateSection 23-35 ms + RT 60-83 ms in
+    // Rio's 0.6.4.3 log). Transient memory only; 384 restores the old cap.
+    TAutoConsoleVariable<int32> CVarBudget(TEXT("worldscape.PreparedMeshBudgetMiB"), 1024,
+        TEXT("Global transient vertex-buffer reservation cap, 0-4096 MiB (default 1024; 384 = before 09.10). Exhaustion uses legacy publication."));
+    TAutoConsoleVariable<int32> CVarPrepareRender(TEXT("worldscape.PreparedRender"), 1,
+        TEXT("Also prepare packed CPU render buffers in the worker; requires PreparedMesh."));
+    std::atomic<int64> LiveBytes{0}, HighBytes{0}, Built{0}, Applied{0}, BudgetFallbacks{0};
+
+    bool Reserve(int64 Bytes, int64 Limit)
+    {
+        int64 Prior = LiveBytes.load();
+        do
+        {
+            if (Bytes <= 0 || Bytes > Limit || Prior > Limit - Bytes)
+            { ++BudgetFallbacks; return false; }
+        } while (!LiveBytes.compare_exchange_weak(Prior, Prior + Bytes));
+        int64 Peak = HighBytes.load();
+        while (Peak < Prior + Bytes && !HighBytes.compare_exchange_weak(Peak, Prior + Bytes)) {}
+        return true;
+    }
+
+    bool BuildSection(FWorldScapePreparedMeshSection& Out, bool bPack, const TArray<FVector>& Positions,
+        const TArray<FVector>& Normals, const TArray<FVector2D>& UV0, const TArray<FVector2D>& UV1,
+        const TArray<FLinearColor>& Colors, const TArray<FWorldScapeMeshTangent>& Tangents)
+    {
+        const int32 Count = Positions.Num();
+        if (Count != Out.Previous.Num()) return false;
+        Out.CpuVertices.Reserve(Count);
+        Out.CpuVertices.Append(Out.Previous.GetData(), Count);
+        Out.Bounds = FBox(Positions);
+        for (int32 I = 0; I < Count; ++I)
+        {
+            auto& V = Out.CpuVertices[I];
+            V.Position = Positions[I];
+            if (Normals.Num() == Count) V.Normal = Normals[I];
+            if (UV0.Num() == Count) V.UV0 = UV0[I];
+            if (UV1.Num() == Count) V.UV1 = UV1[I];
+            if (Colors.Num() == Count) V.Color = Colors[I].ToFColor(false);
+            if (Tangents.Num() == Count) V.Tangent = Tangents[I];
+            // UV2/3 and missing channels deliberately retain the published data.
+        }
+        Out.RenderVertices.Reserve(Count);
+        Out.RenderVertices.Append(Out.CpuVertices);
+        if (bPack && Count > 0)
+        {
+            auto Buffers = MakeShared<FStaticMeshVertexBuffers, ESPMode::ThreadSafe>();
+            // Match InitFromDynamicVertex's CPU setup and conversion exactly.
+            Buffers->PositionVertexBuffer.Init(Count);
+            Buffers->StaticMeshVertexBuffer.Init(Count, 4);
+            Buffers->ColorVertexBuffer.Init(Count);
+            for (int32 I = 0; I < Count; ++I)
+            {
+                const auto& Proc = Out.RenderVertices[I];
+                FDynamicMeshVertex V;
+                V.Position = FVector3f(Proc.Position); V.Color = Proc.Color;
+                V.TextureCoordinate[0] = FVector2f(Proc.UV0); V.TextureCoordinate[1] = FVector2f(Proc.UV1);
+                V.TextureCoordinate[2] = FVector2f(Proc.UV2); V.TextureCoordinate[3] = FVector2f(Proc.UV3);
+                V.TangentX = Proc.Tangent.TangentX; V.TangentZ = Proc.Normal;
+                V.TangentZ.Vector.W = Proc.Tangent.bFlipTangentY ? -127 : 127;
+                Buffers->PositionVertexBuffer.VertexPosition(I) = V.Position;
+                Buffers->StaticMeshVertexBuffer.SetVertexTangents(I, V.TangentX.ToFVector3f(), V.GetTangentY(), V.TangentZ.ToFVector3f());
+                for (int32 U = 0; U < 4; ++U) Buffers->StaticMeshVertexBuffer.SetVertexUV(I, U, V.TextureCoordinate[U]);
+                Buffers->ColorVertexBuffer.VertexColor(I) = V.Color;
+            }
+            Out.PackedBuffers = MoveTemp(Buffers);
+        }
+        return true;
+    }
+}
