+// APS 13.10 (Rio's 11.10 log: 230 frames with the game thread at 50-80 ms in six minutes of low flight over a wet
+// planet, one per ring batch): a finished batch's tasks were deleted on the game thread, each with its three LodData
+// copies (~8 MB a ring, up to 20 rings), and freeing that much in one frame costs tens of ms. 1: a background task
+// frees them. 0: on the game thread (before 13.10).
+static TAutoConsoleVariable<float> CVarAPSWorldScapePublishLogMs(TEXT("worldscape.PublishLogMs"), 15.0f,
+	TEXT("APS: a published ring batch whose game-thread work took longer than this logs its breakdown ([WS.Publish]); 0 = off."));
+static TAutoConsoleVariable<int32> CVarAPSWorldScapeTaskFreeAsync(TEXT("worldscape.TaskFreeAsync"), 1,
+	TEXT("APS: 1 frees a published ring batch's worker tasks on a background task; 0 on the game thread (before 13.10)."));
+// APS 10.10 night (traced far approach): the ring workers start as uncapped background tasks; a batch of ~20 rings at
+// ~0.4 s each took every logical core, and the renderer's own tasks (occlusion culling, dynamic mesh gathering) left the
+// render thread waiting 15-40 ms a few frames after each publication. > 0 caps how many rings generate at once, at low
+// task priority. 0: no cap (before 10.10).
+static TAutoConsoleVariable<int32> CVarAPSWorldScapeGenerationThreads(TEXT("worldscape.GenerationThreads"), 0,
+	TEXT("APS: rings of one WorldScape batch generated at once, at low priority (0 = no cap, all cores, before 10.10)."));
+static FQueuedThreadPool* APSWorldScapeGenerationPool()
+{
+	const int32 Cap = CVarAPSWorldScapeGenerationThreads.GetValueOnGameThread();
+	if (Cap <= 0 || !GThreadPool)
+	{
+		return GThreadPool;
+	}
+	// Never deleted: tasks may still sit in it at shutdown; the wrapper only forwards to GThreadPool.
+	static FQueuedThreadPoolWrapper* Pool = new FQueuedThreadPoolWrapper(GThreadPool, Cap,
+		[](EQueuedWorkPriority) { return EQueuedWorkPriority::Low; });
+	Pool->SetMaxConcurrency(Cap);
+	return Pool;
+}
