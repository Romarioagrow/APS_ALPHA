-void UWorldScapeMeshComponent::ClearMeshSection(int32 SectionIndex)
+static void APSFlushPendingSectionFreesRT()
+{
+	check(IsInRenderingThread());
+	if (GAPSPendingSectionFrees.IsEmpty())
+	{
+		return;
+	}
+	TArray<FWorldScapeMeshSectionUpdateData*> Batch = MoveTemp(GAPSPendingSectionFrees);
+	GAPSPendingSectionFrees.Reset();
+	UE::Tasks::Launch(UE_SOURCE_LOCATION, [Batch = MoveTemp(Batch)]()
+	{
+		for (FWorldScapeMeshSectionUpdateData* Data : Batch)
+		{
+			delete Data;
+		}
+	}, UE::Tasks::ETaskPriority::BackgroundNormal);
+}
+
+bool UWorldScapeMeshComponent::CanPublishPreparedSection(int32 SectionIndex, const FWorldScapePreparedMeshSection& Payload) const
+{
+	if (GetCollisionEnabled() != ECollisionEnabled::NoCollision || !WorldScapeMeshSections.IsValidIndex(SectionIndex)) return false;
+	const auto& Section = WorldScapeMeshSections[SectionIndex];
+	return !Section.bEnableCollision && Section.PlanetVertexBuffer.GetData() == Payload.Previous.GetData()
+		&& Section.PlanetVertexBuffer.Num() == Payload.Previous.Num()
+		&& Payload.CpuVertices.Num() == Payload.Previous.Num() && Payload.RenderVertices.Num() == Payload.Previous.Num();
+}
+
+void UWorldScapeMeshComponent::PublishPreparedSection(int32 SectionIndex, FWorldScapePreparedMeshSection& Payload,
+	const TSharedPtr<FWorldScapePreparedReservation, ESPMode::ThreadSafe>& Reservation)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(WS_PublishPreparedSection);
+	check(IsInGameThread());
+	check(CanPublishPreparedSection(SectionIndex, Payload));
+	auto& Section = WorldScapeMeshSections[SectionIndex];
+	Swap(Section.PlanetVertexBuffer, Payload.CpuVertices);
+	Section.SectionLocalBox = Payload.Bounds;
+	if (SceneProxy && !IsRenderStateDirty())
+	{
+		auto* Data = new FWorldScapeMeshSectionUpdateData;
+		Data->Reservation = Reservation;
+		Data->TargetSection = SectionIndex;
+		Data->NewVertexBuffer = MoveTemp(Payload.RenderVertices);
+		Data->RetiredCpuVertices = MoveTemp(Payload.CpuVertices);
+		Data->PackedBuffers = MoveTemp(Payload.PackedBuffers);
+		auto* Proxy = static_cast<FWorldScapeSceneProxy*>(SceneProxy);
+		ENQUEUE_RENDER_COMMAND(FWorldScapePreparedSectionUpdate)([Proxy, Data](FRHICommandListImmediate& RHICmdList)
+		{ Proxy->UpdateSection_RenderThread(RHICmdList, Data); });
+	}
+	UpdateLocalBounds();
+	MarkRenderTransformDirty();
+}
