+        TPair<const TCHAR*, float>(TEXT("APS_WaterRippleAnalyticControl"), 0.0f)})
+    {
+        auto* Parameter = Core.Add<UMaterialExpressionScalarParameter>(Master);
+        Parameter->ParameterName = P.Key; Parameter->DefaultValue = P.Value;
+        Parameter->UpdateParameterGuid(true, true);
+        if (P.Value == 1.0f) FilterParameter = Parameter;
+        FExpressionInput E; E.Expression = Parameter;
+        Input(P.Value == 1.0f ? TEXT("Filter") : TEXT("AnalyticControl"), E);
