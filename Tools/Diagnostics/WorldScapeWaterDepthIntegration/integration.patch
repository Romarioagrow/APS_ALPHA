diff --git a/Plugins/WorldScape/Source/WorldScapeCore/Public/WorldScapeOceanDepth.h b/Plugins/WorldScape/Source/WorldScapeCore/Public/WorldScapeOceanDepth.h
new file mode 100644
index 0000000..1929379
--- /dev/null
+++ b/Plugins/WorldScape/Source/WorldScapeCore/Public/WorldScapeOceanDepth.h
@@ -0,0 +1,32 @@
+// Optional material-only ocean bathymetry. Geometry, RGBA and UV0 are unchanged.
+#pragma once
+
+#include "CoreMinimal.h"
+
+namespace WorldScapeOceanDepth
+{
+    // Explicit opt-in on generated roots only; legacy/authored worlds do no extra work.
+    inline const FName& RootTag()
+    {
+        static const FName Tag(TEXT("APS.GeneratedOcean.BathymetryUV1"));
+        return Tag;
+    }
+
+    // TEXCOORD1 = (signed water-column depth in kilometres, validity 0/1).
+    // Keep negative land depths through interpolation: clamping each vertex to
+    // zero incorrectly spreads shallows across coast triangles. Clamp in pixel code.
+    // Kilometres fit the existing half-precision UV buffer without changing its ABI.
+    // These are physical displacement heights, never absolute world coordinates,
+    // normalized vertex red, or the camera-to-surface distance.
+    inline FVector2D Encode(double OceanHeightCm, double GroundHeightCm,
+        double PhysicalToMeshScale = 1.0)
+    {
+        if (!FMath::IsFinite(OceanHeightCm) || !FMath::IsFinite(GroundHeightCm)
+            || !FMath::IsFinite(PhysicalToMeshScale) || PhysicalToMeshScale <= 0.0)
+            return FVector2D::ZeroVector;
+        const double DepthKm = ((OceanHeightCm - GroundHeightCm) / PhysicalToMeshScale) * 1.0e-5;
+        // Fail closed instead of sending NaN/Inf or overflowing an FP16 UV.
+        return FMath::IsFinite(DepthKm) && FMath::Abs(DepthKm) <= 60000.0
+            ? FVector2D(DepthKm, 1.0) : FVector2D::ZeroVector;
+    }
+}
