+    bool ValidateWaterDepth()
+    {
+        const bool bTagged = Root->ActorHasTag(WorldScapeOceanDepth::RootTag());
+        int32 Wet = 0, Dry = 0, Invalid = 0, Samples = 0;
+        double MaxErrorKm = 0.0;
+        for (const FSlot& Slot : Slots)
+        {
+            const auto* S = Slot.Mesh->GetProcMeshSection(Slot.Index);
+            double MinDepth = TNumericLimits<double>::Max(), MaxDepth = -TNumericLimits<double>::Max();
+            int32 ValidInSlot = 0;
+            const int32 Stride = FMath::Max(1, S->PlanetVertexBuffer.Num() / 32);
+            for (int32 I = 0; I < S->PlanetVertexBuffer.Num(); ++I)
+            {
+                const auto& V = S->PlanetVertexBuffer[I];
+                if (V.UV1.Y != 1.0 || !FMath::IsFinite(V.UV1.X)) { ++Invalid; continue; }
+                ++ValidInSlot;
+                MinDepth = FMath::Min(MinDepth, V.UV1.X); MaxDepth = FMath::Max(MaxDepth, V.UV1.X);
+                V.UV1.X > 0 ? ++Wet : ++Dry;
+                if (I % Stride != 0) continue;
+                const DVector Ecef = Root->WorldToECEF(Slot.Transform.TransformPosition(V.Position));
+                const FNoiseData Sea = Root->GetGroundNoise(Ecef, true);
+                const FNoiseData Ground = Root->GetGroundNoise(Ecef, false);
+                const FVector2D Expected = WorldScapeOceanDepth::Encode(Sea.Height, Ground.Height);
+                if (Expected.Y != 1.0 || Sea.Hole || Ground.Hole) return false;
+                MaxErrorKm = FMath::Max(MaxErrorKm, FMath::Abs(Expected.X - V.UV1.X));
+                ++Samples;
+            }
+            Test->AddInfo(FString::Printf(TEXT("WATER_DEPTH_SLOT mesh=%s section=%d valid=%d/%d depthM=[%.6g,%.6g] visible=%d"),
+                *Slot.Mesh->GetOuter()->GetName(), Slot.Index, ValidInSlot, S->PlanetVertexBuffer.Num(),
+                ValidInSlot ? MinDepth * 1000.0 : 0.0, ValidInSlot ? MaxDepth * 1000.0 : 0.0, S->bSectionVisible ? 1 : 0));
+        }
+        Test->AddInfo(FString::Printf(TEXT("WATER_DEPTH_GAMEPLAY_PAYLOAD tagged=%d wet=%d dry=%d invalid=%d physicalOracleSamples=%d maxErrorM=%.9g slots=%d"),
+            bTagged ? 1 : 0, Wet, Dry, Invalid, Samples, MaxErrorKm * 1000.0, Slots.Num()));
