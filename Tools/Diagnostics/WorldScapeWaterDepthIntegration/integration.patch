+    // Each band combines twelve distinct directions/frequencies/phases.
+    // A few sine trains look combed; the native simplex gradient looked faceted
+    // in the close fixture even with its footprint filter disabled. The finite
+    // spectrum is differentiable everywhere and filtered per wave frequency.
+    // These remain normal detail, not fluid simulation or displacement.
+    const float WavelengthCm[] = {370.0f, 83.0f};
+    const float Weights[] = {0.65f, 0.35f};
+    for (int32 I = 0; I < UE_ARRAY_COUNT(WavelengthCm); ++I)
+    {
+        auto* Phase = Core.Add<UMaterialExpressionCustom>(Master);
+        Phase->Description = TEXT("APS compensated water detail phase and unwrapped derivatives");
+        Phase->OutputType = CMOT_Float3;
+        Phase->Inputs.Empty();
+        const auto PhaseInput = [Phase](const TCHAR* Name, UMaterialExpression* E, bool bRGB)
+        {
+            FCustomInput Entry; Entry.InputName = Name; Entry.Input.Expression = E;
+            if (bRGB)
+            {
+                Entry.Input.Mask = 1;
+                Entry.Input.MaskR = Entry.Input.MaskG = Entry.Input.MaskB = 1;
+            }
+            Phase->Inputs.Add(Entry);
+        };
+        PhaseInput(TEXT("Raw"), World, false);
+        PhaseInput(TEXT("Center"), Center, true);
+        for (int32 J = 0; J < UE_ARRAY_COUNT(Rows); ++J) PhaseInput(RowInputs[J], Rows[J], true);
+        Phase->Outputs.Reset(3);
+        Phase->Outputs.Add(FExpressionOutput(TEXT("return")));
+        Phase->bShowOutputNameOnPin = true;
+        for (const TCHAR* Name : {TEXT("PhaseDX"), TEXT("PhaseDY")})
+        {
+            FCustomOutput Output; Output.OutputName = Name; Output.OutputType = CMOT_Float3;
+            Phase->AdditionalOutputs.Add(Output);
+            Phase->Outputs.Add(FExpressionOutput(Name));
+        }
+        // Split the physical frame into a uniform view anchor and small pixel
+        // delta. Wrap the anchor before adding the delta to avoid per-pixel
+        // rounding at planetary-sized quotients. The sum remains planet-fixed.
+        // Derivatives use only the small unwrapped delta. Close-view and moving
+        // camera validation remain necessary; no unique cause is proven yet.
+        Phase->Code =
+            TEXT("FDFVector3 ViewOrigin = DFSubtract(DFPromote(float3(0.0,0.0,0.0)), ResolvedView.PreViewTranslation);\n")
+            TEXT("FDFVector3 Relative = DFSubtract(ViewOrigin, WSToDF(LWCCenter));\n")
+            TEXT("FDFVector3 PX = DFMultiply(Relative, MakeDFVector3(XHigh, XLow));\n")
+            TEXT("FDFVector3 PY = DFMultiply(Relative, MakeDFVector3(YHigh, YLow));\n")
+            TEXT("FDFVector3 PZ = DFMultiply(Relative, MakeDFVector3(ZHigh, ZLow));\n")
+            TEXT("FDFScalar X = DFAdd(DFAdd(DFGetX(PX), DFGetY(PX)), DFGetZ(PX));\n")
+            TEXT("FDFScalar Y = DFAdd(DFAdd(DFGetX(PY), DFGetY(PY)), DFGetZ(PY));\n")
+            TEXT("FDFScalar Z = DFAdd(DFAdd(DFGetX(PZ), DFGetY(PZ)), DFGetZ(PZ));\n")
+            TEXT("FDFVector3 Physical = MakeDFVector(X, Y, Z);\n");
+        Phase->Code += FString::Printf(TEXT("float3 Anchor = DFFracDemote(DFDivide(Physical, %.9ff)) * 96.0f;\n"), WavelengthCm[I] * 96.0f);
+        Phase->Code += TEXT("float3 D = Parameters.WorldPosition_NoOffsets_CamRelative;\n")
+            TEXT("float3 Delta = float3(dot(D,XHigh) + dot(D,XLow), dot(D,YHigh) + dot(D,YLow), dot(D,ZHigh) + dot(D,ZLow));\n");
+        Phase->Code += FString::Printf(TEXT("Delta /= %.9ff;\n"), WavelengthCm[I]);
+        Phase->Code += TEXT("PhaseDX = ddx(Delta);\nPhaseDY = ddy(Delta);\n")
+            TEXT("return frac((Anchor + Delta) / 96.0f) * 96.0f;\n");
+        if (I == 0)
+        {
+            FExpressionInput E; E.Expression = Phase;
+            Input(TEXT("PhaseControl"), E);
+        }
+        auto* Gradient = Core.Add<UMaterialExpressionCustom>(Master);
+        Gradient->Description = TEXT("Smooth twelve-wave slope spectrum, per-frequency footprint filter");
+        Gradient->OutputType = CMOT_Float3;
+        Gradient->Inputs.Empty();
+        const TCHAR* InputNames[] = {TEXT("P"), TEXT("DX"), TEXT("DY")};
+        for (int32 J = 0; J < UE_ARRAY_COUNT(InputNames); ++J)
+        {
+            FCustomInput E; E.InputName = InputNames[J]; E.Input.Expression = Phase;
+            E.Input.OutputIndex = J;
+            Gradient->Inputs.Add(E);
+        }
+        FCustomInput FilterInput; FilterInput.InputName = TEXT("Filter"); FilterInput.Input.Expression = FilterParameter;
+        Gradient->Inputs.Add(FilterInput);
+        // Integer vectors make a 96-cell wrap exactly periodic in each axis;
+        // unequal 370/83 cm bands do not share a short combined spatial repeat.
+        const FIntVector WaveVectors[] = { {67,43,58}, {-62,73,19}, {17,-83,56}, {89,11,-37},
+            {-41,-59,-67}, {53,-29,79}, {7,109,31}, {-93,23,47}, {38,61,-85},
+            {-77,-17,33}, {59,-73,-13}, {29,41,101} };
+        Gradient->Code = TEXT("float3 g = 0.0;\n");
+        for (int32 J = 0; J < UE_ARRAY_COUNT(WaveVectors); ++J)
+        {
+            const FIntVector K = WaveVectors[J];
+            const double Offset = FMath::Frac((J+1)*0.61803398875 + (I+1)*0.38196601125);
+            Gradient->Code += FString::Printf(
+                TEXT("{ float3 k = float3(%d.0, %d.0, %d.0);\n")
+                TEXT("float footprint = (abs(dot(DX,k)) + abs(dot(DY,k))) / 96.0;\n")
+                TEXT("float fade = lerp(1.0, 1.0 - smoothstep(0.25,0.5,footprint), saturate(Filter));\n")
+                TEXT("float phase = dot(P,k) / 96.0 + %.9f;\n")
+                TEXT("g += normalize(k) * (cos(phase * 6.28318530718) * (0.40824829 * fade)); }\n"),
+                K.X, K.Y, K.Z, Offset);
+        }
+        Gradient->Code += TEXT("return g;\n");
+        FExpressionInput GradientInput; GradientInput.Expression = Gradient;
+        Input(FName(*FString::Printf(TEXT("G%d"), I)), GradientInput);
+        Ripple->Code += FString::Printf(TEXT("g += G%d * %.9f;\n"), I, Weights[I]);
+    }
+    // Tangential slopes on a sphere; no pole basis, UV seam or LOD normal edge.
+    Ripple->Code += TEXT("if (AnalyticControl > 0.5) g = sin(PhaseControl * 6.28318530718);\n")
+        TEXT("g /= max(1.0, length(g));\nfloat3 n = normalize(Base);\n")
+        TEXT("return normalize(n + clamp(Slope, 0.0, 0.12) * (g - n * dot(g,n)));\n");
+    *Normal = FExpressionInput(); Normal->Expression = Ripple;
+    return true;
+}
+}
