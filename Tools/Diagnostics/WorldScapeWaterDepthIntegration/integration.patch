index 0000000..f0b6b81
--- /dev/null
+++ b/Source/APS_ALPHA/Editor/APSWaterRippleMaterialBuilder.h
@@ -0,0 +1,174 @@
+#pragma once
+
+#if WITH_EDITOR
+#include "APSSharedAmmoniaMaterialBuilder.h"
+
+namespace APSWaterRippleMaterialBuilder
+{
+// A normal-only, stationary small-wave band. Existing coarse waves, colour,
+// roughness, Fresnel, coverage and geometry remain connected exactly as saved.
+inline bool Add(APSSharedTerrainMaterialBuilder::FBuild& Core, UMaterial* Master)
+{
+    auto* Rotation = Cast<UMaterialExpressionCustom>(Master->GetExpressionInputForProperty(MP_Normal)->Expression);
+    if (!Rotation || Rotation->Description != TEXT("APS planet vector to rendered world")) return false;
+    FExpressionInput* Normal = nullptr;
+    for (FCustomInput& Input : Rotation->Inputs)
+        if (Input.InputName == TEXT("V")) Normal = &Input.Input;
+    if (!Normal || !Normal->Expression) return false;
+
+    auto* World = Core.Add<UMaterialExpressionWorldPosition>(Master);
+    auto* Strength = Core.Add<UMaterialExpressionScalarParameter>(Master);
+    auto* Ripple = Core.Add<UMaterialExpressionCustom>(Master);
+    if (!World || !Strength || !Ripple) return false;
+    World->WorldPositionShaderOffset = WPT_ExcludeAllShaderOffsets;
+    auto* Center = Core.Add<UMaterialExpressionDoubleVectorParameter>(Master);
+    Center->ParameterName = TEXT("APS_SharedPlanetCenter");
+    Center->UpdateParameterGuid(true, true);
+    UMaterialExpression* Rows[6] = {};
+    const TCHAR* RowNames[] = {TEXT("APS_SharedDetailRowXHigh"), TEXT("APS_SharedDetailRowXLow"),
+        TEXT("APS_SharedDetailRowYHigh"), TEXT("APS_SharedDetailRowYLow"),
+        TEXT("APS_SharedDetailRowZHigh"), TEXT("APS_SharedDetailRowZLow")};
+    const TCHAR* RowInputs[] = {TEXT("XHigh"), TEXT("XLow"), TEXT("YHigh"), TEXT("YLow"), TEXT("ZHigh"), TEXT("ZLow")};
+    for (int32 I = 0; I < UE_ARRAY_COUNT(Rows); ++I)
+    {
+        auto* Row = Core.Add<UMaterialExpressionVectorParameter>(Master);
+        Row->ParameterName = RowNames[I];
+        Row->DefaultValue = FLinearColor(I == 0 ? 1.0f : 0.0f,
+            I == 2 ? 1.0f : 0.0f, I == 4 ? 1.0f : 0.0f, 0.0f);
+        Row->Group = TEXT("APS Physical Coordinate Contract");
+        Row->UpdateParameterGuid(true, true);
+        Rows[I] = Row;
+    }
+    Strength->ParameterName = TEXT("APS_WaterRippleSlope");
+    Strength->DefaultValue = 0.065f;
+    Strength->SliderMin = 0.0f; Strength->SliderMax = 0.12f;
+    Strength->UpdateParameterGuid(true, true);
+    Ripple->Description = TEXT("Planet-fixed view-anchor phase, footprint-filtered spectral slopes; no displacement");
+    Ripple->OutputType = CMOT_Float3;
+    auto Input = [Ripple](FName Name, FExpressionInput Value)
+    {
+        FCustomInput Entry; Entry.InputName = Name; Entry.Input = Value;
+        Ripple->Inputs.Add(Entry);
+    };
+    Input(TEXT("Base"), *Normal);
+    FExpressionInput StrengthInput; StrengthInput.Expression = Strength;
+    Input(TEXT("Slope"), StrengthInput);
+    UMaterialExpression* FilterParameter = nullptr;
