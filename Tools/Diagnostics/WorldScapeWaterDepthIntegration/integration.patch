--- /dev/null
+++ b/Source/APS_ALPHA/Core/Planetary/APSWaterDepthPalette.h
@@ -0,0 +1,37 @@
+#pragma once
+#include "CoreMinimal.h"
+
+// Candidate-only uniform calculation. It does not select a material or change
+// either palette endpoint, Fresnel, wave normals, geometry or exposure.
+namespace APSWaterDepthPalette
+{
+inline double Luminance(const FLinearColor& C)
+{
+    return double(C.R) * 0.2126 + double(C.G) * 0.7152 + double(C.B) * 0.0722;
+}
+
+inline bool ResolveStrength(const FLinearColor& Deep, const FLinearColor& Shallow,
+    float MaxRelativeLuminanceChange, float& OutStrength)
+{
+    OutStrength = 0.0f;
+    const auto Valid = [](const FLinearColor& C)
+    {
+        return FMath::IsFinite(C.R) && FMath::IsFinite(C.G) && FMath::IsFinite(C.B)
+            && C.R >= 0.0f && C.G >= 0.0f && C.B >= 0.0f;
+    };
+    if (!Valid(Deep) || !Valid(Shallow) || !FMath::IsFinite(MaxRelativeLuminanceChange)
+        || MaxRelativeLuminanceChange < 0.0f || MaxRelativeLuminanceChange > 1.0f) return false;
+
+    const double A = Luminance(Deep), B = Luminance(Shallow);
+    const double Contrast = FMath::Abs(B - A), Floor = FMath::Min(A, B);
+    // Equal-luminance endpoints do not justify an unrestricted hue change.
+    // A black endpoint cannot support a nonzero relative-light budget either.
+    if (Contrast <= 1.e-12 || Floor <= 0.0 || MaxRelativeLuminanceChange == 0.0f) return true;
+    OutStrength = float(FMath::Min(1.0, double(MaxRelativeLuminanceChange) * Floor / Contrast));
+    // For alpha = legacy + (1-legacy)*strength*shallowDepth, legacy and
+    // shallowDepth in [0,1], |delta Y| <= budget * min(A,B) <= budget * Ybase.
+    // This bounds only the linear palette term, not tonemapped pixels, PBR
+    // lighting or physical scattering. Existing filtered depth falloff survives.
+    return true;
+}
+}
