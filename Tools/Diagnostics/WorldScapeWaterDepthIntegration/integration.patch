+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FAPSWaterDepthPaletteBudgetTest,
+    "APS.Materials.WaterDepth.PaletteBudget",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+bool FAPSWaterDepthPaletteBudgetTest::RunTest(const FString&)
+{
+    using namespace APSWaterDepthPalette;
+    const TPair<FLinearColor, FLinearColor> Pairs[] = {
+        {FLinearColor(0.004f, 0.018f, 0.065f), FLinearColor(0.03f, 0.25f, 0.52f)},
+        {FLinearColor(0.5f, 0.3f, 0.2f), FLinearColor(0.01f, 0.02f, 0.04f)},
+        {FLinearColor::Black, FLinearColor::White},
+        {FLinearColor(0.02f, 0.03f, 0.04f), FLinearColor(0.02f, 0.03f, 0.04f)},
+        {FLinearColor(2.0f, 3.0f, 4.0f), FLinearColor(20.0f, 35.0f, 50.0f)}};
+    int32 Samples = 0;
+    for (const auto& P : Pairs)
+    for (float Budget : {0.0f, 0.1f, 0.35f, 1.0f})
+    {
+        float Strength = -1.0f, ScaledStrength = -1.0f;
+        if (!ResolveStrength(P.Key, P.Value, Budget, Strength)
+            || !ResolveStrength(P.Key * 0.125f, P.Value * 0.125f, Budget, ScaledStrength)
+            || Strength < 0.0f || Strength > 1.0f || !FMath::IsFinite(Strength)
+            || FMath::Abs(Strength - ScaledStrength) > 1.e-6f)
+        { AddError(TEXT("Finite bounded palette strength / linear-scale invariance failed")); return false; }
+        for (int32 L = 0; L <= 10; ++L)
+        for (int32 D = 0; D <= 10; ++D)
+        {
+            const double Legacy = L / 10.0, ShallowDepth = D / 10.0;
+            const double A = Luminance(P.Key), B = Luminance(P.Value);
+            const double Before = A + (B - A) * Legacy;
+            const double Alpha = Legacy + (1.0 - Legacy) * Strength * ShallowDepth;
+            const double After = A + (B - A) * Alpha;
+            if (FMath::Abs(After - Before) > Budget * Before + 1.e-6 * FMath::Max(1.0, Before)
+                || (D == 0 && After != Before) || (Budget == 0 && After != Before))
+            { AddError(TEXT("Palette luminance budget or zero/far-depth identity failed")); return false; }
+            ++Samples;
+        }
+    }
+    for (const FLinearColor& Invalid : {FLinearColor(-0.1f, 0.2f, 0.3f),
+        FLinearColor(std::numeric_limits<float>::quiet_NaN(), 0, 0),
+        FLinearColor(0, std::numeric_limits<float>::infinity(), 0)})
+    {
+        float Strength = -1.0f;
+        TestFalse(TEXT("Reject invalid deep palette"), ResolveStrength(Invalid, FLinearColor::White, 0.35f, Strength));
+        TestEqual(TEXT("Rejected deep palette clears output"), Strength, 0.0f);
+        TestFalse(TEXT("Reject invalid shallow palette"), ResolveStrength(FLinearColor::White, Invalid, 0.35f, Strength));
+        TestEqual(TEXT("Rejected shallow palette clears output"), Strength, 0.0f);
+    }
+    for (float Invalid : {-0.1f, 1.1f, std::numeric_limits<float>::quiet_NaN(), std::numeric_limits<float>::infinity()})
+    {
+        float Strength = -1.0f;
+        TestFalse(TEXT("Reject invalid budget"), ResolveStrength(Pairs[0].Key, Pairs[0].Value, Invalid, Strength));
+        TestEqual(TEXT("Rejected budget clears output"), Strength, 0.0f);
+    }
+    AddInfo(FString::Printf(TEXT("PALETTE_BUDGET samples=%d; palette-term numeric evidence only, not shader/FPS/visual acceptance"), Samples));
+    return true;
+}
