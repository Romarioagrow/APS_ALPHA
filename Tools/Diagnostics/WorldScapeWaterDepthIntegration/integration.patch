+                const TArray<FLinearColor>* Colors[] = {&Lod->VertexColors, &Lod->VerticesColorPA, &Lod->VerticesColorPB};
+                const TArray<FVector2D>* Depth[] = {&Lod->UV1, &Lod->UV1PA, &Lod->UV1PB};
