diff --git a/host/Source/APS_ALPHA/Editor/APSWaterCurrentMaterialBuilder.h b/host/Source/APS_ALPHA/Editor/APSWaterCurrentMaterialBuilder.h
new file mode 100644
--- /dev/null
+++ b/host/Source/APS_ALPHA/Editor/APSWaterCurrentMaterialBuilder.h
@@ -0,0 +1,86 @@
+#pragma once
+#if WITH_EDITOR
+#include "APSSharedAmmoniaMaterialBuilder.h"
+#include "Materials/MaterialExpressionTime.h"
+
+namespace APSWaterCurrentMaterialBuilder
+{
+// Appearance of slow mixing fronts, not a fluid solver. Three-dimensional
+// planet-fixed coordinates avoid polar seams and per-patch UV/LOD dependence.
+// Only water's reflectance/roughness change; no emission, opacity or geometry.
+inline bool Add(APSSharedTerrainMaterialBuilder::FBuild& Core, UMaterial* Master)
+{
+    FExpressionInput* Base = Master->GetExpressionInputForProperty(MP_BaseColor);
+    FExpressionInput* Roughness = Master->GetExpressionInputForProperty(MP_Roughness);
+    if (!Base || !Base->Expression || !Roughness || !Roughness->Expression) return false;
+    auto* World = Core.Add<UMaterialExpressionWorldPosition>(Master);
+    World->WorldPositionShaderOffset = WPT_ExcludeAllShaderOffsets;
+    auto* Center = Core.Add<UMaterialExpressionDoubleVectorParameter>(Master);
+    Center->ParameterName = TEXT("APS_SharedPlanetCenter");
+    Center->UpdateParameterGuid(true, true);
+    auto* Time = Core.Add<UMaterialExpressionTime>(Master);
+    Time->bOverride_Period = true; Time->Period = 4096.0f;
+    auto* Strength = Core.Add<UMaterialExpressionScalarParameter>(Master);
+    Strength->ParameterName = TEXT("APS_WaterCurrentStrength");
+    Strength->DefaultValue = 0.5f;
+    Strength->SliderMin = 0.0f; Strength->SliderMax = 1.0f;
+    Strength->Group = TEXT("APS Ocean Currents"); Strength->UpdateParameterGuid(true, true);
+    auto* Field = Core.Add<UMaterialExpressionCustom>(Master);
+    Field->Description = TEXT("Planet-fixed ocean mixing fronts; continuous periodic time and pixel footprint filter");
+    Field->OutputType = CMOT_Float1;
+    const auto Input = [Field](const TCHAR* Name, UMaterialExpression* E, bool RGB = false)
+    {
+        FCustomInput I; I.InputName = Name; I.Input.Expression = E;
+        if (RGB) I.Input.Mask = I.Input.MaskR = I.Input.MaskG = I.Input.MaskB = 1;
+        Field->Inputs.Add(I);
+    };
+    Input(TEXT("Raw"), World); Input(TEXT("Center"), Center, true);
+    Input(TEXT("Seconds"), Time); Input(TEXT("Strength"), Strength);
+    const TCHAR* Names[] = {TEXT("APS_SharedDetailRowXHigh"), TEXT("APS_SharedDetailRowXLow"),
+        TEXT("APS_SharedDetailRowYHigh"), TEXT("APS_SharedDetailRowYLow"),
+        TEXT("APS_SharedDetailRowZHigh"), TEXT("APS_SharedDetailRowZLow")};
+    const TCHAR* Pins[] = {TEXT("XHigh"), TEXT("XLow"), TEXT("YHigh"), TEXT("YLow"), TEXT("ZHigh"), TEXT("ZLow")};
+    for (int32 I = 0; I < UE_ARRAY_COUNT(Names); ++I)
+    {
+        auto* Row = Core.Add<UMaterialExpressionVectorParameter>(Master);
+        Row->ParameterName = Names[I];
+        Row->DefaultValue = FLinearColor(I == 0 ? 1.f : 0.f, I == 2 ? 1.f : 0.f, I == 4 ? 1.f : 0.f, 0.f);
+        Row->UpdateParameterGuid(true, true); Input(Pins[I], Row, true);
+    }
+    // Divide while still compensated: casting absolute planet coordinates to
+    // float before subtraction/division would reintroduce blocky flow fields.
+    // Time is CPU-periodic, and every temporal phase has an integer cycle count,
+    // so the 4096-second wrap has matching values AND first derivatives.
+    Field->Code = TEXT("FDFVector3 r = DFSubtract(WSToDF(LWCRaw), WSToDF(LWCCenter));\n")
+        TEXT("FDFVector3 x = DFMultiply(r, MakeDFVector3(XHigh,XLow));\n")
+        TEXT("FDFVector3 y = DFMultiply(r, MakeDFVector3(YHigh,YLow));\n")
+        TEXT("FDFVector3 z = DFMultiply(r, MakeDFVector3(ZHigh,ZLow));\n")
+        TEXT("FDFVector3 p = MakeDFVector(DFAdd(DFAdd(DFGetX(x),DFGetY(x)),DFGetZ(x)), DFAdd(DFAdd(DFGetX(y),DFGetY(y)),DFGetZ(y)), DFAdd(DFAdd(DFGetX(z),DFGetY(z)),DFGetZ(z)));\n")
+        TEXT("float3 q = DFDemote(DFDivide(p, 600000.0f));\n")
+        TEXT("float t = Seconds * (6.28318530718 / 4096.0);\n")
+        TEXT("float a = dot(q,float3(0.73,0.29,-0.41));\n")
+        TEXT("float b = dot(q,float3(-0.31,0.61,0.47));\n")
+        TEXT("float c = dot(q,float3(0.23,-0.53,0.67));\n")
+        TEXT("float3 phase = float3(a + 1.4*sin(b + t), b + 1.1*sin(c - t), c + 0.8*sin(a + t));\n")
+        TEXT("phase += float3(t,-t,2.0*t);\n")
+        TEXT("float3 footprint = (abs(ddx(phase)) + abs(ddy(phase))) * 0.15915494309;\n")
+        TEXT("float3 fade = 1.0 - smoothstep(0.125,0.35,footprint);\n")
+        TEXT("return clamp(dot(sin(phase)*fade,float3(0.5,0.3,0.2)), -1.0, 1.0)*saturate(Strength);\n");
+    for (EMaterialProperty Property : {MP_BaseColor, MP_Roughness})
+    {
+        FExpressionInput* Output = Master->GetExpressionInputForProperty(Property);
+        auto* Mix = Core.Add<UMaterialExpressionCustom>(Master);
+        Mix->Description = TEXT("Bounded ocean current reflectance; strength zero restores exact baseline");
+        Mix->OutputType = Property == MP_BaseColor ? CMOT_Float3 : CMOT_Float1;
+        FCustomInput Original; Original.InputName = TEXT("Original"); Original.Input = *Output;
+        FCustomInput Current; Current.InputName = TEXT("Current"); Current.Input.Expression = Field;
+        Mix->Inputs = {Original, Current};
+        Mix->Code = Property == MP_BaseColor
+            ? TEXT("return Original * (1.0 + 0.08 * Current);")
+            : TEXT("return Original + clamp(0.03 * Current, -max(Original,0.0), max(1.0-Original,0.0));");
+        Output->Connect(0, Mix);
+    }
+    return true;
+}
+}
+#endif
