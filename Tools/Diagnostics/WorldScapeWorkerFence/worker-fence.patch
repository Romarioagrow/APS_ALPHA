diff --git a/Source/WorldScapeCore/Private/Tests/APSWorldScapeWorkerCompletionTests.cpp b/Source/WorldScapeCore/Private/Tests/APSWorldScapeWorkerCompletionTests.cpp
new file mode 100644
--- /dev/null
+++ b/Source/WorldScapeCore/Private/Tests/APSWorldScapeWorkerCompletionTests.cpp
@@ -0,0 +1,65 @@
+#if WITH_DEV_AUTOMATION_TESTS
+#include "Misc/AutomationTest.h"
+#include "WorldScapeRoot.h"
+#include "Engine/World.h"
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FAPSWorldScapeWorkerCompletionTest,
+    "APS.Gameplay.World.PlanetSurface.WorkerCompletionOwnership",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FAPSWorldScapeWorkerCompletionTest::RunTest(const FString& Parameters)
+{
+    UWorld* World = UWorld::CreateWorld(EWorldType::Game, false);
+    if (!TestNotNull(TEXT("Worker test world"), World)) return false;
+    AWorldScapeRoot* Root = World->SpawnActor<AWorldScapeRoot>();
+    if (!TestNotNull(TEXT("Worker test root"), Root)) { World->DestroyWorld(false); return false; }
+    Root->NoiseIntensity = 0;
+    Root->bGenerateTangents = false;
+    constexpr double Radius = 10000000.0;
+    constexpr int32 Count = 32;
+    for (int32 Batch = 0; Batch < 3; ++Batch)
+    {
+        for (int32 Index = 0; Index < Count; ++Index)
+        {
+            UWorldScapeLod* Lod = NewObject<UWorldScapeLod>(Root);
+            const DVector Position(FVector(0.0, 0.0, Radius));
+            Lod->Init(0, 16, 1920.0, Position, FWSMaterialLodArray{}, Radius,
+                DVector(0), false, false);
+            Root->WorldScapeLod.Add(Lod);
+            // Intentionally grow the pending map while previous tasks run.
+            Root->WorldScapeLodInGeneration.Add(Lod, false);
+            auto* Task = new FAsyncTask<LodGenerationThread>(Lod, Root, Position,
+                DVector(0), FVector2D(Index & 1, (Index >> 1) & 1), Radius,
+                0, 120.0f, 16, 1000.0, FVector::UpVector, false, false);
+            Root->LodGenerationThreadPool.Add(Task);
+            Task->StartBackgroundTask();
+        }
+        for (auto* Task : Root->LodGenerationThreadPool) Task->EnsureCompletion();
+        TestEqual(TEXT("Pending targets retained until game-thread publish"),
+            Root->WorldScapeLodInGeneration.Num(), Count);
+        for (const auto& Pair : Root->WorldScapeLodInGeneration)
+            TestFalse(TEXT("Workers never mutate the game-thread pending map"), Pair.Value);
+        Root->CheckForLodGeneration();
+        TestEqual(TEXT("Whole completed batch published"), Root->WorldScapeLodInGeneration.Num(), 0);
+        TestEqual(TEXT("Completed task objects released"), Root->LodGenerationThreadPool.Num(), 0);
+        Root->CleanComponents();
+        TestEqual(TEXT("Regeneration removes old LODs"), Root->WorldScapeLod.Num(), 0);
+    }
+    // Explicit regeneration may arrive with a worker still queued/running.
+    UWorldScapeLod* Lod = NewObject<UWorldScapeLod>(Root);
+    const DVector Position(FVector(0.0, 0.0, Radius));
+    Lod->Init(0, 16, 1920.0, Position, FWSMaterialLodArray{}, Radius, DVector(0), false, false);
+    Root->WorldScapeLod.Add(Lod);
+    Root->WorldScapeLodInGeneration.Add(Lod, false);
+    auto* Task = new FAsyncTask<LodGenerationThread>(Lod, Root, Position,
+        DVector(0), FVector2D::ZeroVector, Radius, 0, 120.0f, 16, 1000.0,
+        FVector::UpVector, false, false);
+    Root->LodGenerationThreadPool.Add(Task);
+    Task->StartBackgroundTask();
+    Root->CleanComponents();
+    TestEqual(TEXT("Explicit rebuild drains outstanding tasks"), Root->LodGenerationThreadPool.Num(), 0);
+    TestEqual(TEXT("Explicit rebuild clears pending targets"), Root->WorldScapeLodInGeneration.Num(), 0);
+    World->DestroyWorld(false);
+    return true;
+}
+#endif
