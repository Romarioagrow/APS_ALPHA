 void AWorldScapeRoot::CleanComponents()
 {
+	// Workers own the pending LOD payload until their async task has completed.
+	// Explicit regeneration must drain them before destroying their components.
+	for (FAsyncTask<LodGenerationThread>* Task : LodGenerationThreadPool)
+	{
+		if (!Task) continue;
+		if (!Task->Cancel()) Task->EnsureCompletion();
+		delete Task;
+	}
+	LodGenerationThreadPool.Empty();
 	if (GenerationType == EWorldScapeType::Planet)
 	{
 		PlanetScaleCode = PlanetScale;
@@ -1791,9 +1800,12 @@ void AWorldScapeRoot::CheckForLodGeneration()
 {
 	bool DoneGenerating = true;
 	
-	for (const TPair<UWorldScapeLod*, bool>& Pair : WorldScapeLodInGeneration)
+	// The pending TMap is game-thread-owned. Workers must never read/write it
+	// while this thread can grow/rehash it when scheduling the rest of a batch.
+	// IsDone also fences the payload and the worker tail before publication.
+	for (FAsyncTask<LodGenerationThread>* Task : LodGenerationThreadPool)
 	{
-		if (!Pair.Value)
+		if (Task && !Task->IsDone())
 		{
 			DoneGenerating = false;
 			break;
@@ -1811,6 +1823,10 @@ void AWorldScapeRoot::CheckForLodGeneration()
 				updateMaterial = true;
 			}
 		}
+		for (FAsyncTask<LodGenerationThread>* Task : LodGenerationThreadPool)
+		{
+			delete Task; // All tasks passed IsDone; do not leak one task per LOD update.
+		}
 		LodGenerationThreadPool.Empty();
 
 		TransformKeeper->UpdateBounds();
