+void AWorldScapeRoot::RestoreCollisionSampleColors(UWorldScapeLod* CollisionLod)
+{
+	check(IsInGameThread());
+	if (!IsValid(CollisionLod) || CollisionLod->CollisionHeightOnlyPositions.IsEmpty()) return;
+	check(CollisionLod->CollisionHeightOnlyPositions.Num() == CollisionLod->Vertices.Num());
+	TArray<FHeightMapVolumeDataCopy> Heights;
+	TArray<FNoiseVolumeData> Noises;
+	TArray<FTerrainHoleVolumeData> Holes;
+	TArray<FTransform> Transforms;
+	GetVolumesData(Heights, Noises, Holes, CollisionLod->GetFBox());
+	for (const auto& Height : Heights) Transforms.Add(Height.VolumeLocation);
+	CollisionLod->VertexColors.SetNumUninitialized(CollisionLod->Vertices.Num());
+	for (int32 I = 0; I < CollisionLod->Vertices.Num(); ++I)
+	{
+		const FNoiseData Data = GetNoise(CollisionLod->CollisionHeightOnlyPositions[I], Noises, Heights, Holes, Transforms);
+		CollisionLod->VertexColors[I] = FLinearColor(Data.HeightNormalize, Data.Temperature, Data.Humidity, Data.FoliageMask);
+	}
+	// UpdateMeshSection requires full positions and then refits physics. Instead
+	// change only the public CPU section colours and recreate its render proxy;
+	// leave positions/topology and the cooked body intact, including while frozen.
+	if (IsValid(CollisionLod->Mesh))
+	{
+		FWorldScapeMeshSection* Section = CollisionLod->Mesh->GetProcMeshSection(0);
+		if (!ensure(Section && Section->PlanetVertexBuffer.Num() == CollisionLod->VertexColors.Num())) return;
+		for (int32 I = 0; I < CollisionLod->VertexColors.Num(); ++I)
+			Section->PlanetVertexBuffer[I].Color = CollisionLod->VertexColors[I].ToFColor(false);
+		CollisionLod->Mesh->MarkRenderStateDirty();
+	}
+	CollisionLod->CollisionHeightOnlyPositions.Empty();
+}
